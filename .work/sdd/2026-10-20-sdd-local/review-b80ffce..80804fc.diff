+if ! python3 - "$REPO_DIR/opencode.jsonc" <<'PY'
+import json
+import sys
+from pathlib import Path
+
+
+def remove_comments(source):
+    result = []
+    index = 0
+    quoted = False
+    escaped = False
+    while index < len(source):
+        char = source[index]
+        following = source[index + 1] if index + 1 < len(source) else ""
+        if quoted:
+            result.append(char)
+            if escaped:
+                escaped = False
+            elif char == "\\":
+                escaped = True
+            elif char == '"':
+                quoted = False
+            index += 1
+        elif char == '"':
+            quoted = True
+            result.append(char)
+            index += 1
+        elif char == "/" and following == "/":
+            index += 2
+            while index < len(source) and source[index] != "\n":
+                index += 1
+        elif char == "/" and following == "*":
+            end = source.find("*/", index + 2)
+            if end < 0:
+                raise ValueError("unterminated JSONC block comment")
+            result.extend("\n" for line in source[index:end + 2] if line == "\n")
+            index = end + 2
+        else:
+            result.append(char)
+            index += 1
+    return "".join(result)
+
+
+def remove_trailing_commas(source):
+    result = []
+    index = 0
+    quoted = False
+    escaped = False
+    while index < len(source):
+        char = source[index]
+        if quoted:
+            result.append(char)
+            if escaped:
+                escaped = False
+            elif char == "\\":
+                escaped = True
+            elif char == '"':
+                quoted = False
+            index += 1
+        elif char == '"':
+            quoted = True
+            result.append(char)
+            index += 1
+        elif char == ",":
+            lookahead = index + 1
+            while lookahead < len(source) and source[lookahead].isspace():
+                lookahead += 1
+            if lookahead < len(source) and source[lookahead] in "]}":
+                index += 1
+            else:
+                result.append(char)
+                index += 1
+        else:
+            result.append(char)
+            index += 1
+    return "".join(result)
+
+
+config = json.loads(remove_trailing_commas(remove_comments(Path(sys.argv[1]).read_text())))
+servers = config.get("mcp", {}).get("servers", {})
+missing = {"context7", "codegraph"} - set(servers)
+if missing:
+    raise SystemExit("missing mcp.servers declarations: " + ", ".join(sorted(missing)))
+PY
+then
+  fail 'context7 and codegraph must remain under mcp.servers'
 fi
