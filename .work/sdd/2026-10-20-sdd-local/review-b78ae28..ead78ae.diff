+#!/usr/bin/env bash
+set -euo pipefail
+
+REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
+FILES=(
+  "$REPO_DIR/skills/ship-change/SKILL.md"
